# ---------------------------------------------------------------------------
# Aetheria — what is deliberately not in version control
# ---------------------------------------------------------------------------

# Dependencies. Restored with `pnpm install`; never commit (tens of thousands of
# files, platform-specific binaries, and a lockfile already pins the graph).
node_modules/

# Build output. Regenerated by `pnpm build`; committing it would mean reviewing
# minified bundles and would let stale artifacts drift from the source.
dist/
.vite/
*.tsbuildinfo

# Measurement output. `pnpm verify` writes these on every run and they embed
# machine-specific timings, so they are artifacts rather than sources. The
# published numbers live in README.md; regenerate the rest locally.
perf/

# Logs and crash output.
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Editor and OS noise.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local environment overrides: personal paths, tokens, ports. Never published.
.env
.env.*
!.env.example

# Scratch space that tooling may create while debugging shaders or captures.
tools/wgsl-dump/
tools/tmp/
*.local

# WebGPU / WebGL capture dumps and shader caches produced by developers.
*.trace
*.gpucapture
*.spv
*.cache
